{"id":"NCT05421741","title":"Prophylactic Antibiotic Coated Nail to Prevent Infection: A Clinical Trial","official":"Prophylactic Antibiotic Coated Nail to Prevent Infection: A Clinical Trial","summary":"This prospective randomized clinical trial will compare outcomes between patients treated primarily with a prophylactic antibiotic coated nail and those treated with traditional standard of care intramedullary (IM) nailing.","conditions":["Osteomyelitis Tibia","Tibial Fractures","Open Tibia Fracture"],"interventions":[{"type":"DRUG","name":"Antibiotic coated intramedullary Nail"},{"type":"OTHER","name":"Standard Intramedullary Nail"}],"criteria":"Inclusion Criteria:\n\n* Patients 18 years or older\n* Gustilo Type II or III open tibia fracture requiring definitive fixation with intramedullary nail\n\nExclusion Criteria:\n\n* Less than 18 years of age\n* Allergy to vancomycin or gentamicin\n* Unable to speak English or Spanish\n* Pregnant and lactating women\n* Prisoner\n* Unable to follow up for 12 months","minAge":"18 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"INTERVENTIONAL","purpose":"PREVENTION","enrollment":242,"start":"2023-05-15","pcd":"2026-12","upd":"2026-08-18","sponsor":"Wake Forest University Health Sciences","areas":["other"],"central":["Rachel Seymour, PhD · 7043552000 · Rachel.Seymour@advocatehealth.org","Christine Churchill, MA · 7043552000 · Christine.Churchill@advocatehealth.org"],"sites":[{"f":"University of Florida Gainesville","city":"Gainesville","pr":"Florida","zip":"32607","s":"R","lat":29.6516,"lon":-82.3248,"c":"Michael Talerico, MD"},{"f":"Florida Orthopaedic Institute","city":"Temple Terrace","pr":"Florida","zip":"33637","s":"R","lat":28.0353,"lon":-82.3893,"c":"Lisa Stang"},{"f":"Atrium Health Navicent","city":"Macon","pr":"Georgia","zip":"31201","s":"R","lat":32.8407,"lon":-83.6324,"c":"Jarrod Dumpe, MD"},{"f":"The University of Chicago","city":"Chicago","pr":"Illinois","zip":"60637","s":"R","lat":41.85,"lon":-87.65,"c":