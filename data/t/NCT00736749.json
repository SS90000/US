{"id":"NCT00736749","title":"Long-Term Follow-Up of Patients Who Have Participated in Children's Oncology Group Studies","official":"Umbrella Long-Term Follow-Up Protocol","summary":"This clinical trial keeps track of and collects follow-up information from patients who are currently enrolled on or have participated in a Children's Oncology Group study. Developing a way to keep track of patients who have participated in Children's Oncology Group studies may allow doctors learn more about the long-term effects of cancer treatment and help them reduce problems related to treatment and improve patient quality of life.","conditions":["Hematopoietic Cell Transplantation Recipient","Leukemia","Solid Tumor"],"interventions":[{"type":"PROCEDURE","name":"Assessment of Therapy Complications"},{"type":"OTHER","name":"Questionnaire Administration"}],"criteria":"Inclusion Criteria:\n\n* The patient must reside in the U.S. on the date of enrollment to ALTE05N1\n* All patients and/or their parents or legal guardians must sign a written informed consent\n* All institutional, Food and Drug Administration (FDA), and National Cancer Institute (NCI) requirements for human studies must be met","minAge":"","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":25000,"start":"2008-07-17","pcd":"2100-01-31","upd":"2026-10-20","sponsor":"Children's Oncology Group","areas":["oncology"],"central":[],"sites":[{"f":"Children's Hospital of Alabama","city":"Birmingham","pr":"Alabama","zip":"35233","s":"R","lat":33.5207,"lon":-86.8025,"c":"Site Public Contact · helpdesk@childrensoncologygroup.org"},{"f":"University of Alabama at Birmingham Cancer Center","city":"Birmingham","pr":"Alabama","zip":"35233","s":"ANR","lat":33.5207,"lon":-86.8025,"c":""},{"f":"USA Health Strada Patient Care Center","city":"Mobile","pr":"Alabama","zip":"36604","s":"R","lat":30.6944,"lon":-88.043,"c":"Site Public Contact · 800-388-8721"},{"f":"Phoenix Childrens Hospital","city":"Phoe