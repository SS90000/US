{"id":"NCT06961968","title":"Randomized Withdrawal Study in Patients With Schizophrenia","official":"A Multicenter, Double-Blind, Randomized Withdrawal Study in Patients With Schizophrenia Receiving Either Iloperidone Long-Acting Injection (LAI) or Placebo Injection","summary":"The purpose of this research is to evaluate the efficacy of dosing iloperidone long-acting injection (LAI) compared to placebo in preventing the exacerbation of symptoms in patients with schizophrenia.","conditions":["Schizophrenia"],"interventions":[{"type":"DRUG","name":"iloperidone"},{"type":"DRUG","name":"placebo"}],"criteria":"Inclusion Criteria:\n\n* Males or females 18 to 65 years of age (inclusive)\n* Diagnosed with schizophrenia per DSM-5 criteria\n* In need of ongoing psychiatric treatment\n\nExclusion Criteria:\n\n* DSM-5 diagnosis of a psychiatric disorder other than schizophrenia that was the primary focus of treatment within the previous six months","minAge":"18 Years","maxAge":"65 Years","sex":"ALL","healthy":false,"studyType":"INTERVENTIONAL","purpose":"TREATMENT","enrollment":400,"start":"2025-05-14","pcd":"2027-11","upd":"2026-01-12","sponsor":"Vanda Pharmaceuticals","areas":["other"],"central":["Vanda Pharmaceuticals Inc. · 202-734-3400 · clinicaltrials@vandapharma.com"],"sites":[{"f":"Vanda Investigational Site","city":"Rogers","pr":"Arkansas","zip":"72758","s":"R","lat":36.332,"lon":-94.1185,"c":"Vanda Pharmaceuticals · 202-734-3400"},{"f":"Vanda Investigational Site","city":"Costa Mesa","pr":"California","zip":"92626","s":"R","lat":33.6411,"lon":-117.9187,"c":"Vanda Pharmaceuticals · 202-734-3400"},{"f":"Vanda Investigational Site","city":"Lemon Grove","pr":"California","zip":"91945","s":"R","lat":32.7426,"lon":-117.0314,"c":"Vanda Pharmaceuticals · 202-734-3400"},{"f":"Vanda Investigational Site","city":"Oceanside","pr":"California","zip":"92056","s":"R","lat":33.1959,"lon":-117.3795,"c":"Vanda Pharmaceuticals · 202-734-3400"},{"f":"Vanda Investigational Site","city":"P