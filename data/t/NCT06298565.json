{"id":"NCT06298565","title":"A Non-interventional, Post-authorisation Safety Study of Patients Treated With Efgartigimod Alfa","official":"A Non-interventional, Post-authorisation Safety Study of Patients Treated With Efgartigimod Alfa","summary":"This is a non-interventional, prospective, post authorization safety study. Patients with gMG who are expected to start treatment with efgartigimod at enrolment or are within their first cycle of efgartigimod at enrolment will be eligible to enroll into the efgartigimod cohort. Patients with gMG who have not been exposed to efgartigimod and for whom it is not planned to start treatment with efgartigimod at enrolment will be eligible to enroll into the non-efgartigimod cohort.","conditions":["Myasthenia Gravis"],"interventions":[{"type":"BIOLOGICAL","name":"efgartigimod"}],"criteria":"Inclusion Criteria:\n\n* Patients diagnosed with gMG who are expected to start commercial efgartigimod at enrolment or who are within their first cycle of efgartigimod at enrolment or Patients diagnosed with gMG who have not been exposed to efgartigimod and for whom it is not planned to start treatment with efgartigimod at enrolment\n* Have provided appropriate written informed consent\n\nExclusion Criteria:\n\n* None","minAge":"18 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":680,"start":"2024-11-04","pcd":"2034-06","upd":"2026-02-17","sponsor":"argenx","areas":["neurology"],"central":["Sabine Coppieters, MD · 857-350-4834 · Clinicaltrials@argenx.com"],"sites":[{"f":"UCSF Medical Center - Helen Diller Family Comprehensive Cancer Center - Brain Tumor Center,","city":"San Francisco","pr":"California","zip":"94143","s":"R","lat":37.7749,"lon":-122.4194,"c":"Min Kang, MD · 857-350-4834 · clinicaltrials@argenx.com"},{"f":"SFM Clinical Research, LLC","city":"Boca Raton","pr":"Florida","zip":"33487","s":"R","lat":26.3587,"lon":-80.0831,"c":"Marc Feinberg, MD · 857-350-4834 · clinicaltrials@argen