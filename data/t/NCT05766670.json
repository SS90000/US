{"id":"NCT05766670","title":"Intramedullary Calcium Sulfate Antibiotic Depot","official":"Intramedullary Calcium Sulfate Antibiotic Depot for Prevention of Open Fracture Related Infection: A Randomized Clinical Trial","summary":"The goal of this randomized clinical trial is to study the best treatment for open lower leg fractures to prevent infection. The main questions it aims to answer is if treating tibia fracture patients with a calcium sulfate antibiotic depot is better at preventing infection that the standard of care.","conditions":["Open tíbia Fracture","Osteomyelitis Tibia","Tibial Fractures"],"interventions":[{"type":"DRUG","name":"Vancomycin Hydrochloride"},{"type":"DRUG","name":"Gentamicin"},{"type":"OTHER","name":"Standard Intramedullary Nail"}],"criteria":"Inclusion Criteria:\n\n* Patients 18 years and older\n* Type II or III open tibia fracture requiring definitive fixation with intramedullary nail\n\nExclusion Criteria:\n\n* Less than 18 years of age\n* Allergy to vancomycin or tobramycin\n* Hypercalcemia\n* Unable to speak English or Spanish\n* No email, phone, or other point of contact\n* Pregnant and lactating women\n* Prisoner","minAge":"18 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"INTERVENTIONAL","purpose":"OTHER","enrollment":242,"start":"2024-04-08","pcd":"2027-01","upd":"2026-10-14","sponsor":"Wake Forest University Health Sciences","areas":["other"],"central":["Christine Churchill, MA · 7043552000 · christine.churchill@advocatehealth.org","Rachel B Seymour, PhD · 7043552000 · Rachel.Seymour@advocatehealth.org"],"sites":[{"f":"Cedars-Sinai","city":"Los Angeles","pr":"California","zip":"90048","s":"R","lat":34.0522,"lon":-118.2437,"c":"Geoffrey Marecek, MD"},{"f":"Atrium Health Navicent The Medical Center","city":"Macon","pr":"Georgia","zip":"31201","s":"R","lat":32.8407,"lon":-83.6324,"c":"Jarrod Dumpe, MD · jarrod.dumpe@atriumhealth.org"},{"f":"University of Chicago","city":"Chicago","pr":"Illinois","zip":"60637","s":"R","l