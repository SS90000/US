{"id":"NCT05685303","title":"Alleviant ALLAY-HF Study","official":"Safety and Efficacy of the Alleviant System for No-Implant Interatrial Shunt Creation in Patients With Chronic Heart Failure","summary":"Prospective, multicenter, randomized, sham-controlled, double blinded, adaptive study designed to evaluate the safety and efficacy of a percutaneously created interatrial shunt using the Alleviant ALV1 System in patients with HFpEF/HFmrEF.","conditions":["Heart Failure"],"interventions":[{"type":"DEVICE","name":"Alleviant ALV1 System"},{"type":"OTHER","name":"Sham-Control"}],"criteria":"Inclusion Criteria:\n\n1. Symptomatic HFpEF/HFmrEF with LVEF greater than or equal to 40%\n2. NYHA Class II, III or ambulatory IV\n3. Exercise right heart catheterization\\*\n\n   1. Elevated left atrial pressure during exercise right heart catheterization (greater than or equal to 25 mmHg)\n   2. Exercise PVR \\< 1.8 WU\n4. Ongoing stable GDMT\n\nExclusion Criteria:\n\n1. Advanced heart failure\n2. Presence of a pacemaker\n3. Evidence of right heart dysfunction","minAge":"40 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"INTERVENTIONAL","purpose":"TREATMENT","enrollment":700,"start":"2023-01-10","pcd":"2027-12-01","upd":"2026-08-14","sponsor":"Alleviant Medical, Inc.","areas":["other"],"central":["Jennifer Olson · +1 612 327 2741 · jen.olson@alleviantmedical.com"],"sites":[{"f":"Arizona Cardiovascular Research Center","city":"Phoenix","pr":"Arizona","zip":"85016","s":"ANR","lat":33.4484,"lon":-112.074,"c":""},{"f":"HonorHealth","city":"Scottsdale","pr":"Arizona","zip":"85258","s":"STOP","lat":33.5092,"lon":-111.899,"c":""},{"f":"Pima Heart and Vascular","city":"Tucson","pr":"Arizona","zip":"85718","s":"R","lat":32.2217,"lon":-110.9265,"c":""},{"f":"Memorial Care Long Beach Medical Center","city":"Long Beach","pr":"California","zip":"90806","s":"R","lat":33.767,"lon":-118.1892,"c":""},{"f":"UC Davis Medical Center","city":"Sacramento","pr":"California","zip":"95817","s":