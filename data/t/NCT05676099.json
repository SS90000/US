{"id":"NCT05676099","title":"TSC Biosample Repository and Natural History Database","official":"TSC Alliance Tuberous Sclerosis Complex (TSC) Biosample Repository and Natural History Database","summary":"The TSC Biosample Repository collects and stores samples of blood, DNA, and tissues that scientists can request to use in their research. The samples we collect are all linked to clinical data in the TSC Natural History Database. The TSC Natural History Database captures clinical data to document the impact of the disease on a person's health over his or her lifetime. This data may be collected retrospectively or prospectively.","conditions":["Tuberous Sclerosis","Lymphangioleiomyomatosis"],"interventions":[{"type":"PROCEDURE","name":"Phlebotomy"},{"type":"PROCEDURE","name":"Buccal (cheek) swab"},{"type":"GENETIC","name":"Genetic Testing"},{"type":"OTHER","name":"Tissue donation after routine clinical procedure"}],"criteria":"Inclusion Criteria:\n\n* Diagnosis of tuberous sclerosis complex or lymphangioleiomyomatosis (sporadic LAM).\n\nExclusion Criteria:\n\n\\-","minAge":"","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":5000,"start":"2016-01","pcd":"2050-12","upd":"2026-06-24","sponsor":"National Tuberous Sclerosis Association","areas":["other"],"central":["Elizabeth Cassidy, MPH · 301-562-9890 · ecassidy@tscalliance.org","Ayat Abi · aabi@tscalliance.org"],"sites":[{"f":"University of Alabama Birmingham","city":"Birmingham","pr":"Alabama","zip":"","s":"R","lat":33.5207,"lon":-86.8025,"c":"Jessica Krefting, RN, BSN · 205-975-2890 · jessicakrefting@uabmc.edu"},{"f":"Loma Linda University Children's Hospital","city":"Loma Linda","pr":"California","zip":"","s":"R","lat":34.0483,"lon":-117.2612,"c":"Jose Navarro, LVN · 909-558-5830 · JDNavarro@llu.edu"},{"f":"University of California Los Angeles","city":"Los Angeles","pr":"California","zip":"90095","s":"R","lat":34.0522,"lon":-118.2437,"c":"Ruby Escalante · 310-206-5586 · R