{"id":"NCT04674969","title":"Drug-Eluting Registry: Real-World Treatment of Lesions in the Peripheral Vasculature","official":"Drug-Eluting Registry: Real-World Treatment of Lesions in the Peripheral Vasculature (ELEGANCE)","summary":"The ELEGANCE Registry's objective is to collect Real-World Data (RWD), including populations previously not represented in Peripheral Vascular Disease (PVD) trials, health economics data, and to support the safe use of commercially available Boston Scientific Corporation (BSC) drug-eluting devices for the treatment of lesions located in the peripheral vasculature.","conditions":["Peripheral Vascular Diseases"],"interventions":[{"type":"DEVICE","name":"Any eligible commercially available Boston Scientific Corporation (BSC) drug-eluting device."}],"criteria":"Inclusion Criteria:\n\n* Patients 18 years and older\n* Written informed consent (patient data release-form)\n* Use of any commercially available Boston Scientific drug-eluting device marketed for treatment of lesions in the peripheral vasculature and specified in the Registry Enrollment Guide\n\nExclusion Criteria:\n\n* Life expectancy of \\<1 year","minAge":"18 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":5000,"start":"2021-03-29","pcd":"2028-01","upd":"2026-10-16","sponsor":"Boston Scientific Corporation","areas":["other"],"central":["Yumna Akhtar, MS · 651-399-6775 · yumna.akhtar@bsci.com","Kara Johnson · 763-334-2963 · kara.johnson2@bsci.com"],"sites":[{"f":"St. Bernard's Medical Center","city":"Jonesboro","pr":"Arkansas","zip":"72401","s":"R","lat":35.8423,"lon":-90.7043,"c":""},{"f":"PIH Health Good Samaritan Hospital","city":"Los Angeles","pr":"California","zip":"90017","s":"R","lat":34.0522,"lon":-118.2437,"c":""},{"f":"Cedars - Sinai Medical Center","city":"Los Angeles","pr":"California","zip":"90048","s":"R","lat":34.0522,"lon":-118.2437,"c":""},{"f":"Ronald Reagan UCLA Medical Center","city":"Los Angeles","pr":"Cali