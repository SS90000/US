{"id":"NCT05301140","title":"Vivistim Registry for Paired VNS Therapy (GRASP)","official":"Vivistim Registry for Paired VNS Therapy (GRASP)","summary":"The purpose of the Vivistim Registry for Paired VNS Therapy (GRASP) is to gather real-world information on patients with arm and hand deficits post-stroke who are considering Vivistim System treatment. Before and after Vivistim System implant, patient data will be collected and reported throughout the therapy process. Physicians or sites will receive appropriate remuneration for the effort and cost involved in collecting and transmitting this data to MicroTransponder Inc.","conditions":["Upper Extremity Problem"],"interventions":[{"type":"DEVICE","name":"Vivistim System"}],"criteria":"Inclusion Criteria:\n\n* Patients implanted with the Vivistim System for upper limb deficits associated with an ischemic stroke\n\nExclusion Criteria:\n\n* Not eligible for surgery","minAge":"22 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":1000,"start":"2023-03-15","pcd":"2028-12-31","upd":"2026-10-09","sponsor":"MicroTransponder Inc.","areas":["neurology"],"central":["Brent Tarver, BSEE · 8556289375 · brent.tarver@mobia.com","Diana Hansen · 8556289375 · diana.hansen@mobia.com"],"sites":[{"f":"Advent Health Orlando","city":"Orlando","pr":"Florida","zip":"32803","s":"R","lat":28.5383,"lon":-81.3792,"c":"Ariana Mora · 407-609-9057 · Ariana.Mora@adventhealth.com"},{"f":"Alexian Brothers Health System","city":"Elk Grove Village","pr":"Illinois","zip":"60007","s":"R","lat":42.0039,"lon":-87.9703,"c":"Ashley Madsen · 847.437.5500 x7273 · ashley.madsen@ascension.org"},{"f":"Ascension Alexian Brothers Rehabilitation Hospital","city":"Elk Grove Village","pr":"Illinois","zip":"60007","s":"R","lat":42.0039,"lon":-87.9703,"c":"Katherine Enzler · 312-238-2941 · Katherine.enzler@ascension.org"},{"f":"Endeavor Health","city":"Evanston","pr":"Illinois","zip":"60201","s":"R","lat":42.0411,"lon":-87