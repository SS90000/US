{"id":"NCT03228290","title":"Functional Assessment in Liver Transplantation","official":"Functional Assessment in Liver Transplant Candidates (FrAILT) Study","summary":"This will be a prospective cohort study of patients with liver disease. Subjects will undergo geriatric assessments of frailty, functional status, and disability using functional status measures at baseline and at every clinic visit in the pre-transplant setting. Subjects will also answer questions regarding quality of life, personality, and/or cognitive function. Subjects will again undergo assessments at every clinic visit through 12 months after transplant. Then, they will be followed annually.","conditions":["End Stage Liver Disease"],"interventions":[],"criteria":"Inclusion Criteria:\n\n* Adult (≥18 years old)\n* Are seen for the treatment of liver disease","minAge":"18 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":5000,"start":"2011-10-12","pcd":"2030-12-31","upd":"2026-07-14","sponsor":"University of California, San Francisco","areas":["other"],"central":["Jennifer C Lai, MD, MBA · (415) 476-6422 · jennifer.lai@ucsf.edu","Fawzy Barry, BS · (415) 476-6119 · fawzy.barry@ucsf.edu"],"sites":[{"f":"University of Arkansas for Medical Sciences","city":"Little Rock","pr":"Arkansas","zip":"72205","s":"STOP","lat":34.7465,"lon":-92.2896,"c":""},{"f":"Loma Linda University","city":"Loma Linda","pr":"California","zip":"92354","s":"STOP","lat":34.0483,"lon":-117.2612,"c":""},{"f":"University of California, San Francisco","city":"San Francisco","pr":"California","zip":"94143","s":"R","lat":37.7749,"lon":-122.4194,"c":"Jennifer C Lai, MD, MBA · 415-476-2777 · jennifer.lai@ucsf.edu"},{"f":"Northwestern University","city":"Chicago","pr":"Illinois","zip":"60611","s":"R","lat":41.85,"lon":-87.65,"c":"Daniel Ganger, MD · 312-695-4496 · dganger@nmff.org"},{"f":"Indiana University","city":"Indianapolis","pr":"Indiana","zip":"46202","s":"ANR","lat":39.7684,"lon"