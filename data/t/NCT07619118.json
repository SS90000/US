{"id":"NCT07619118","title":"A Phase III Study to Assess the Effect of FDC Laroprovstat/Rosuvastatin Compared With Rosuvastatin on LDL-C in Patients With Hypercholesterolaemia","official":"A Phase III Randomised, Double-Blind, Parallel-Group Study to Assess the Effect of Fixed Dose Combination Laroprovstat/Rosuvastatin Compared With Rosuvastatin on Low-Density Lipoprotein Cholesterol in Patients With Hypercholesterolaemia","summary":"The purpose of this study is to evaluate the effect on low-density lipoprotein-cholesterol (LDL-C) and the safety and tolerability of a fixed dose combination (FDC) of laroprovstat/rosuvastatin versus rosuvastatin alone in patients with hypercholesterolaemia with either a history of a clinical atherosclerotic cardiovascular disease (ASCVD) event or at increased risk for a first clinical ASCVD event.","conditions":["Hypercholesterolaemia"],"interventions":[{"type":"COMBINATION_PRODUCT","name":"laroprovstat/rosuvastatin 1"},{"type":"COMBINATION_PRODUCT","name":"laroprovstat/rosuvastatin 2"},{"type":"COMBINATION_PRODUCT","name":"laroprovstat/rosuvastatin 3"},{"type":"COMBINATION_PRODUCT","name":"laroprovstat/rosuvastatin 4"},{"type":"DRUG","name":"Placebo to match laroprovstat/rosuvastatin 1,2,3"},{"type":"DRUG","name":"Placebo to match laroprovstat/rosuvastatin 4"},{"type":"DRUG","name":"Rosuvastatin 1"},{"type":"DRUG","name":"Rosuvastatin 2"},{"type":"DRUG","name":"Rosuvastatin 3"},{"type":"DRUG","name":"Rosuvastatin 4"},{"type":"DRUG","name":"Placebo to match Rosuvastatin"}],"criteria":"Inclusion Criteria:\n\n* Participant must be ≥ 18 years of age\n* Participants must be on a stable dose of all background LLTs\n* The stable statin dose should be judged as their maximally tolerated dose\n* Participants should have either history of a clinical ASCVD event or be at increased risk for a first clinical ASCVD event\n\nExclusion Criteria:\n\n* Asian origin\n* Uncontrolled severe hypertension\n* Uncontrolled T2DM\n* Inadequately treated hypothyroidism","minAge":"18 Years","maxAge":"130 Years","sex":"ALL","healthy":false,"studyType":"INTERVENTIONAL","purpose":"TREATMENT","enrollment":200,"start":"2026-09-10","pcd":"2027-05-28","upd":"2026-10-05","sponsor":"AstraZeneca","areas":["other"],"central":["AstraZeneca Clinical Study Information Center · 1-877-240-9479 · information.center@astrazeneca.com"],"sites":[{"f":"Research Site","city":"Sun City West","pr":"Arizona","zip":"85375","s":"R","lat":33.662,"lon":-112.3413,"c":""},{"f":"Research Site","city":"Gardena","pr":"California","zip":"90247","s":"NYR","lat":33.8884,"lon":-118.309,"c":""},{"f":"Research Site","city":"Lomita","pr":"California","zip":"90717","s":"NYR","lat":33.7922,"lon":-118.3151,"c":""},{"f":"Research Site","city":"Pomona","pr":"California","zip":"91768","s":"R","lat":34.0553,"lon":-117.7523,"c":""},{"f":"Research Site","city":"Sacramento","pr":"California","zip":"95821","s":"NYR","lat":38.5816,"lon":-121.4944,"c":""},{"f":"Research Site","city":"Jacksonville","pr":"Florida","zip":"32216","s":"NYR","lat":30.3322,"lon":-81.6556,"c":""},{"f":"Research Site","city":"Miami Lakes","pr":"Florida","zip":"33016","s":"R","lat":25.9087,"lon":-80.3087,"c":""},{"f":"Research Site","city":"Orlando","pr":"Florida","zip":"32807","s":"NYR","lat":28.5383,"lon":-81.3792,"c":""},{"f":"Research Site","city":"Pembroke Pines","pr":"Florida","zip":"33029","s":"NYR","lat":26.0032,"lon":-80.2239,"c":""},{"f":"Research Site","city":"Conyers","pr":"Georgia","zip":"30094","s":"R","lat":33.6676,"lon":-84.0177,"c":""},{"f":"Research Site","city":"Decatur","pr":"Georgia","zip":"30030","s":"R","lat":33.7748,"lon":-84.2963,"c":""},{"f":"Research Site","city":"Peachtree Corners","pr":"Georgia","zip":"30092","s":"NYR","lat":33.9701,"lon":-84.2216,"c":""},{"f":"Research Site","city":"Evansville","pr":"Indiana","zip":"47714","s":"NYR","lat":37.9748,"lon":-87.5559,"c":""},{"f":"Research Site","city":"Indianapolis","pr":"Indiana","zip":"46260","s":"STOP","lat":39.7684,"lon":-86