{"id":"NCT00674388","title":"The Pediatric Anesthesia Quality Improvement Project","official":"The Pediatric Anesthesia Quality Improvement Project","summary":"The Study is designed to collect information about adverse events that occur in children undergoing anesthesia in participating hospitals. Demographic information will be collected on all anesthetics. An analysis of each adverse event will be performed and entered into the database. From this information we will devise strategies to prevent these adverse events.","conditions":["Surgery","Anesthesia","Children"],"interventions":[],"criteria":"Inclusion Criteria:\n\n* All children undergoing anesthesia at participating hospitals\n\nExclusion Criteria:\n\n* Patients over 21 years of age","minAge":"","maxAge":"21 Years","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":5000000,"start":"2008-02","pcd":"2035-12","upd":"2025-05-21","sponsor":"The Society for Pediatric Anesthesia","areas":["other"],"central":["Jayant K Deshpande, MD, MPH · 8045656348 · wakeupsafe@gmail.com","Anna Varughese, MD · 7277672108 · anna.varughese@jhmi.edu"],"sites":[{"f":"Phoenix Children's Hospital","city":"Phoenix","pr":"Arizona","zip":"85106","s":"R","lat":33.4484,"lon":-112.074,"c":"Ahmar Husain, MD · (602) 262-8900 · Ahmar.Husain@shcr.com"},{"f":"Arkansas Children's Hospital","city":"Little Rock","pr":"Arkansas","zip":"72202","s":"R","lat":34.7465,"lon":-92.2896,"c":"Tatyana Demidovich, MD · 314 577 8750 · tatyana.demidovich@health.slu.edu"},{"f":"Children's Hospital Los Angeles","city":"Los Angeles","pr":"California","zip":"90027","s":"R","lat":34.0522,"lon":-118.2437,"c":"Neha Patel, MD · 323 361 2262 · NePatel@chla.usc.edu"},{"f":"Oakland Medical Center","city":"Oakland","pr":"California","zip":"94611","s":"R","lat":37.8044,"lon":-122.2708,"c":"Nick Riegels, MD · 510 752 1000 · riegelsn@gmail.com"},{"f":"Lucile Packard Children's Hospital Stanford","city":"Palo Alto","pr":"California","zip":"94304","s